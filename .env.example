# Dr. Sturgis - environment configuration
# Copy this file to ".env" and fill in your own key. Never share your .env
# or commit it to version control. The key stays on this machine: the browser
# only ever talks to the local backend, which calls Google Gemini for you.

# Get a key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Optional: override the Gemini model (default: gemini-flash-lite-latest).
# NOTE: flagship models (3.7/3.8-flash) may return 503 "high demand" errors;
# the lite model responds reliably and is cheaper for short practice replies.
GEMINI_MODEL=gemini-flash-lite-latest

# Optional: server port (default: 8765)
PORT=8765
